# Copy to .env for local development. Replace the sample password before use.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=costume_db
DB_USERNAME=costume_user
DB_PASSWORD=change-me-for-local-development

# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=designer-costume-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
PASSWORD_RESET_DELIVERY=development
PASSWORD_RESET_EXPIRATION=900000
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@designer-costume.local

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
AI_SERVICE_PORT=8001
