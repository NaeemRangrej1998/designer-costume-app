AI_SERVICE_PORT=8001
AI_APP_VERSION=0.2.0

# Required for all /api/v1/* routes. Generate a long random token; never commit it.
AI_SERVICE_API_TOKEN=

# Inference is disabled by default; enabling it does not grant commercial rights.
MODEL_NAME=fashn-vton-1.5
MODEL_VERSION=1.5.0
MODEL_USE_MODE=disabled
MODEL_LICENSE_ACKNOWLEDGED=false
MODEL_WEIGHTS_DIR=./weights
MODEL_DEVICE=auto
MODEL_NUM_TIMESTEPS=30
MODEL_GUIDANCE_SCALE=1.5
MODEL_SEED=42
MODEL_MAX_CONCURRENT_JOBS=1
AI_MAX_UPLOAD_BYTES=10485760
AI_MAX_IMAGE_DIMENSION=4096
AI_TEMP_DIR=
HF_HOME=./.cache/huggingface
